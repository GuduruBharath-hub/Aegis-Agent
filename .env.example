# ---------------------------------------------------------------------------
# Model chain (trusted orchestrator process only - never reaches the sandbox)
#
# Providers are tried in order. Failover covers transport only: a provider that
# is rate limited, out of credit or unreachable is skipped. A patch REJECTED BY
# A GATE never triggers failover - that is the system working, and the retry
# stays with the same model.
#
# Every slot speaks the OpenAI chat-completions protocol, so adding a provider
# is three environment variables and no code.
# A slot is used only when all three of its values are set.
# ---------------------------------------------------------------------------

# 1 - PRIMARY: GLM
AEGIS_MODEL_1_API_KEY=
AEGIS_MODEL_1_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AEGIS_MODEL_1_NAME=glm-5.3

# 2 - FALLBACK: DeepSeek. Different vendor, so a Zhipu outage does not take
#     both slots down. Cheap, strong on code, generous limits.
AEGIS_MODEL_2_API_KEY=
AEGIS_MODEL_2_BASE_URL=https://api.deepseek.com/v1
AEGIS_MODEL_2_NAME=deepseek-chat

# 3 - LAST RESORT: OpenRouter. A meta-provider rather than a single vendor, so
#     this slot is itself redundant and can reach a free-tier model when the
#     paid slots are exhausted.
AEGIS_MODEL_3_API_KEY=
AEGIS_MODEL_3_BASE_URL=https://openrouter.ai/api/v1
AEGIS_MODEL_3_NAME=qwen/qwen-2.5-coder-32b-instruct

# Shared across every slot
AEGIS_MODEL_MAX_TOKENS=8000
AEGIS_MODEL_TEMPERATURE=0
AEGIS_LLM_TIMEOUT_S=60
AEGIS_LLM_CONCURRENCY=1
AEGIS_LLM_TRANSPORT_RETRIES=2

# Legacy single-provider names. Still honoured as slot 1 when the
# AEGIS_MODEL_1_* values above are unset.
FEATHER_API_KEY=
FEATHER_BASE_URL=https://api.featherless.ai/v1
AEGIS_MODEL=

# GitHub (trusted orchestrator process only)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_S=30
GITHUB_TRANSPORT_RETRIES=2
GITHUB_WEBHOOK_SECRET=

# Sandbox
AEGIS_SANDBOX_TIER=docker
AEGIS_SANDBOX_IMAGE=aegis-sandbox:py311
AEGIS_SANDBOX_TIMEOUT_S=90
AEGIS_SANDBOX_MEMORY=512m
AEGIS_SANDBOX_CPUS=1.0

# Policy and budgets
AEGIS_POLICY_PATH=policies/security_policy.json
AEGIS_MAX_ATTEMPTS=3
AEGIS_JOB_WALL_CLOCK_S=480

# Runtime
AEGIS_DB_PATH=./aegis.db
AEGIS_WORKSPACE_ROOT=./.workspaces
AEGIS_LOG_LEVEL=INFO
AEGIS_DEMO_MODE=true
AEGIS_REPLAY_DIR=./replay
CORS_ORIGINS=http://localhost:3000
