# ---------------------------------------------------------------------------
# Model chain (trusted orchestrator process only - never reaches the sandbox)
#
# Providers are tried in order. Failover covers TRANSPORT, not judgement: a
# provider that is rate limited, out of credit, unreachable, or returning
# unusable output is skipped. A patch REJECTED BY A GATE never triggers
# failover - that is the system working, and the retry stays with the model
# that produced the rejected patch.
#
# Every slot speaks the OpenAI chat-completions protocol, so adding a provider
# is three environment variables and no code. A slot is used only when all
# three of its values are set; a half-configured slot is skipped at load.
# ---------------------------------------------------------------------------

# --- Option A (configured here): one Featherless key, three models ----------
# Featherless serves thousands of open-weight models behind a single
# OpenAI-compatible endpoint, so one key fills all three slots.
#
# TRADE-OFF, stated plainly: three slots on one key share one account and one
# quota. This protects against a model being down, overloaded, or emitting
# unusable output. It does NOT protect against the key running out of credit -
# that takes all three down together. For real vendor redundancy, point one
# slot at Option B below.

# Order is by MEASURED reliability, not reputation. See docs/DECISIONS.md for
# the probe results that produced it.
AEGIS_MODEL_1_API_KEY=
AEGIS_MODEL_1_BASE_URL=https://api.featherless.ai/v1
AEGIS_MODEL_1_NAME=deepseek-ai/DeepSeek-V3.2

# Dedicated code model from a different lab. Diversity of training lineage
# matters: a failure mode shared across one family defeats the point of a chain.
AEGIS_MODEL_2_API_KEY=
AEGIS_MODEL_2_BASE_URL=https://api.featherless.ai/v1
AEGIS_MODEL_2_NAME=Qwen/Qwen3-Coder-480B-A35B-Instruct

# Last resort. GLM did not serve reliably through Featherless when measured
# (see DECISIONS.md). Kept in the chain because a third lab is worth having,
# and because the router only reaches it when the first two are unavailable.
# For GLM as a PRIMARY, use Zhipu's own endpoint under Option B instead.
AEGIS_MODEL_3_API_KEY=
AEGIS_MODEL_3_BASE_URL=https://api.featherless.ai/v1
AEGIS_MODEL_3_NAME=zai-org/GLM-5.3

# --- Option B: a genuinely different vendor for one slot --------------------
# Swap either fallback to one of these when you want quota independence.
#   DeepSeek     https://api.deepseek.com/v1          deepseek-chat
#   OpenRouter   https://openrouter.ai/api/v1         qwen/qwen-2.5-coder-32b-instruct
#   Zhipu direct https://open.bigmodel.cn/api/paas/v4 glm-5.3

# Shared across every slot
AEGIS_MODEL_MAX_TOKENS=8000
AEGIS_MODEL_TEMPERATURE=0
AEGIS_LLM_TIMEOUT_S=60
AEGIS_LLM_CONCURRENCY=1                  # load-bearing: parallel requests on one
                                         # Featherless key return HTTP 429
AEGIS_LLM_TRANSPORT_RETRIES=2

# Legacy single-provider names. Still honoured as slot 1 when the
# AEGIS_MODEL_1_* values above are unset.
FEATHER_API_KEY=
FEATHER_BASE_URL=https://api.featherless.ai/v1
AEGIS_MODEL=

# GitHub (trusted orchestrator process only)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_S=30
GITHUB_TRANSPORT_RETRIES=2
GITHUB_WEBHOOK_SECRET=

# Sandbox
AEGIS_SANDBOX_TIER=docker
AEGIS_SANDBOX_IMAGE=aegis-sandbox:py311
AEGIS_SANDBOX_TIMEOUT_S=90
AEGIS_SANDBOX_MEMORY=512m
AEGIS_SANDBOX_CPUS=1.0

# Policy and budgets
AEGIS_POLICY_PATH=policies/security_policy.json
AEGIS_MAX_ATTEMPTS=3
AEGIS_JOB_WALL_CLOCK_S=480

# Runtime
AEGIS_DB_PATH=./aegis.db
AEGIS_WORKSPACE_ROOT=./.workspaces
AEGIS_LOG_LEVEL=INFO
AEGIS_DEMO_MODE=true
AEGIS_REPLAY_DIR=./replay
CORS_ORIGINS=http://localhost:3000
