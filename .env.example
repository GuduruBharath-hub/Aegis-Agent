# Feather AI (trusted orchestrator process only)
FEATHER_API_KEY=
FEATHER_BASE_URL=https://api.featherless.ai/v1
AEGIS_MODEL=moonshotai/Kimi-K3
AEGIS_MODEL_MAX_TOKENS=8000
AEGIS_MODEL_TEMPERATURE=0
AEGIS_LLM_TIMEOUT_S=60
AEGIS_LLM_CONCURRENCY=1
AEGIS_LLM_TRANSPORT_RETRIES=2

# GitHub (trusted orchestrator process only)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_S=30
GITHUB_TRANSPORT_RETRIES=2
GITHUB_WEBHOOK_SECRET=

# Sandbox
AEGIS_SANDBOX_TIER=docker
AEGIS_SANDBOX_IMAGE=aegis-sandbox:py311
AEGIS_SANDBOX_TIMEOUT_S=90
AEGIS_SANDBOX_MEMORY=512m
AEGIS_SANDBOX_CPUS=1.0

# Policy and budgets
AEGIS_POLICY_PATH=policies/security_policy.json
AEGIS_MAX_ATTEMPTS=3
AEGIS_JOB_WALL_CLOCK_S=480

# Runtime
AEGIS_DB_PATH=./aegis.db
AEGIS_WORKSPACE_ROOT=./.workspaces
AEGIS_LOG_LEVEL=INFO
AEGIS_DEMO_MODE=true
AEGIS_REPLAY_DIR=./replay
CORS_ORIGINS=http://localhost:3000
